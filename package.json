{
  "name": "lox-highlighter",
  "displayName": "Lox Highlighter",
  "description": "Semantic highlighting for Lox",
  "version": "0.0.1",
  "publisher": "salluzziluca",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:semanticLanguage"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "semanticLanguage",
        "aliases": [
          "Semantic Language"
        ],
        "extensions": [
          ".semanticLanguage",
          ".lox"
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}