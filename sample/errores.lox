// Archivo de prueba para diagnostics
//
// Casos activos: errores semánticos que la extensión debería mostrar todos juntos.
// Casos comentados: errores de parser. Descomentá uno por vez para probarlos,
// porque un ParseError corta el análisis y VS Code solo mostrará ese error.

// 1) Variable redeclarada en el mismo scope
var duplicada = 1;
var duplicada = 2;

// 2) Función redeclarada en el mismo scope
fun repetida() {
  return 1;
}

fun repetida() {
  return 2;
}

// 3) Parámetro redeclarado en la misma función
fun conParametrosRepetidos(a, b, a) {
  return a + b;
}

// 4) return fuera de una función
return 123;

// 5) Variable no definida
print noDefinida;

// 6) Leer una variable en su propio inicializador
var propia = propia;

