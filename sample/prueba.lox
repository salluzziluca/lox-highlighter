// ============================================
// prueba del parser — casos límite y anidamiento
// ============================================

// precedencia de operadores
var a = 1 + 2 * 3;         // debe ser 7, no 9
var b = (1 + 2) * 3;       // debe ser 9
var c = 2 ** 3 ** 2;       // potencia
var d = !true == false;    // negación antes de comparación
var e = -1 + -2;           // unarios encadenados

// comparaciones encadenadas
var f = 1 < 2 == true;
var g = 1 + 2 > 3 - 1;

// asignación encadenada
var x = 1;
var y = 1;
x = y = 10;  // asociativo por la derecha

// funciones anidadas
fun externa(a, b) {
    fun interna(c) {
        return a + c;
    }
    return interna(b);
}

// recursión mutua
fun esPar(n) {
    if (n == 0) return true;
    return esImpar(n - 1);
}

fun esImpar(n) {
    if (n == 0) return false;
    return esPar(n - 1);
}

// for desazucarado
var suma = 0;
for (var i = 1; i <= 10; i = i + 1) {
    suma = suma + i;
}

// while con break simulado via variable
var seguir = true;
var contador = 0;
while (seguir) {
    contador = contador + 1;
    if (contador >= 5) {
        seguir = false;
    }
}

// if else anidado
fun clasificar(n) {
    if (n < 0) {
        return "negativo";
    } else {
        if (n == 0) {
            return "cero";
        } else {
            return "positivo";
        }
    }
}

// llamadas encadenadas como argumentos
fun identidad(x) {
    return x;
}

var resultado = identidad(identidad(identidad(42)));

// expresiones como argumentos
fun sumar(a, b) {
    return a + b;
}

var r = sumar(1 + 2, 3 * 4);
var s = sumar(sumar(1, 2), sumar(3, 4));

// operadores lógicos
var t = true and false;
var u = false or true;
var v = !false and !false;

// strings
var saludo = "hola" + " " + "mundo";
var vacio = "";

// nil
var nada = nil;
var esNil = nada == nil;

// fibonacci iterativo
fun fibIter(n) {
    var a = 0;
    var b = 1;
    for (var i = 0; i < n; i = i + 1) {
        var temp = a + b;
        a = b;
        b = temp;
    }
    return a;
}

// fibonacci recursivo
fun fibRec(n) {
    if (n <= 1) return n;
    return fibRec(n - 1) + fibRec(n - 2);
}

print fibIter(10);
print fibRec(10);
print clasificar(-5);
print clasificar(0);
print clasificar(5);
print esPar(4);
print esImpar(3);
print externa(1, 2);
print resultado;