{
  "name": "Lox Custom",
  "type": "dark",
  "colors": {
    "editor.background": "#1E111B",
    "editor.foreground": "#F8EAF4",
    "editor.lineNumberColor": "#8E6A82",
    "editor.selectionBackground": "#FF4FA366",
    "editor.wordHighlightBackground": "#FF8CC833",

    "sideBar.background": "#24131F",
    "sideBar.foreground": "#F3D9EA",

    "activityBar.background": "#170D15",
    "activityBar.foreground": "#FF79C6",

    "titleBar.activeBackground": "#24131F",
    "titleBar.activeForeground": "#FFD6EC",

    "statusBar.background": "#FF4FA3",
    "statusBar.foreground": "#1E111B",

    "tab.activeBackground": "#2D1827",
    "tab.inactiveBackground": "#1A0F17",
    "tab.activeForeground": "#FFD6EC",
    "tab.inactiveForeground": "#9C7D90",

    "editorCursor.foreground": "#FF79C6",
    "editorWhitespace.foreground": "#5A3F50",

    "input.background": "#2A1723",
    "input.foreground": "#FFEAF6",

    "button.background": "#FF4FA3",
    "button.foreground": "#1E111B",
    "button.hoverBackground": "#FF79C6"
  },

  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#8E6A82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.double",
        "string.quoted.single"
      ],
      "settings": {
        "foreground": "#FF9ED2"
      }
    },
    {
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.declaration",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#FF4FA3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FFB3E6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "scope": [
        "variable",
        "identifier"
      ],
      "settings": {
        "foreground": "#F8EAF4"
      }
    },
    {
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF5CAD"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#FFC2E8"
      }
    }
  ]
}